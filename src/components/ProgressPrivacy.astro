---
// Progress and Privacy component
---
<section id="privacy" class="section-pad" style="max-width:1120px;margin:0 auto;padding:112px 32px 0">
  <div class="privacy-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:20px">
    <div style="background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.06);border-radius:26px;padding:34px 32px 36px">
      <h3 style="margin:0;font-size:26px;font-weight:700;letter-spacing:-.02em">Momentum you can see</h3>
      <p style="margin:10px 0 0;font-size:14.5px;line-height:1.55;color:#8b99b0;max-width:340px">
        Reps per session, average form and personal bests, all in one tab.
      </p>
      <div style="margin-top:28px;display:flex;align-items:flex-end;gap:10px;height:110px">
        <div style="flex:1;height:48%;border-radius:6px 6px 0 0;background:rgba(255,255,255,.14)"></div>
        <div style="flex:1;height:62%;border-radius:6px 6px 0 0;background:rgba(255,255,255,.14)"></div>
        <div style="flex:1;height:44%;border-radius:6px 6px 0 0;background:rgba(255,255,255,.14)"></div>
        <div style="flex:1;height:76%;border-radius:6px 6px 0 0;background:rgba(255,255,255,.14)"></div>
        <div style="flex:1;height:58%;border-radius:6px 6px 0 0;background:rgba(255,255,255,.14)"></div>
        <div style="flex:1;height:88%;border-radius:6px 6px 0 0;background:rgba(255,255,255,.14)"></div>
        <div style="flex:1;height:70%;border-radius:6px 6px 0 0;background:#AAEC58;box-shadow:0 0 16px -2px rgba(170,236,88,0.4)"></div>
      </div>
      <div style="margin-top:22px;display:flex;gap:12px;flex-wrap:wrap">
        <div style="flex:1;min-width:80px;background:rgba(255,255,255,.05);border-radius:14px;padding:14px 16px">
          <div style="font:700 20px 'Space Grotesk', sans-serif">28</div>
          <div style="font-size:11px;color:#8b99b0">most reps</div>
        </div>
        <div style="flex:1;min-width:80px;background:rgba(255,255,255,.05);border-radius:14px;padding:14px 16px">
          <div style="font:700 20px 'Space Grotesk', sans-serif">9.1</div>
          <div style="font-size:11px;color:#8b99b0">best form</div>
        </div>
        <div style="flex:1;min-width:80px;background:rgba(255,255,255,.05);border-radius:14px;padding:14px 16px">
          <div style="font:700 20px 'Space Grotesk', sans-serif">7.8</div>
          <div style="font-size:11px;color:#8b99b0">avg form</div>
        </div>
      </div>
    </div>
    <div style="background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.06);border-radius:26px;padding:34px 32px 36px;display:flex;flex-direction:column">
      <h3 style="margin:0;font-size:26px;font-weight:700;letter-spacing:-.02em">The camera stays yours</h3>
      <p style="margin:10px 0 0;font-size:14.5px;line-height:1.55;color:#8b99b0">
        Everything runs on your device. No video is recorded, uploaded or sent anywhere, and there's no account to create.
      </p>
      <div style="margin-top:26px;display:flex;flex-direction:column;gap:10px">
        <div style="display:flex;align-items:center;gap:12px;background:rgba(255,255,255,.05);border-radius:14px;padding:14px 16px;font-size:14px;font-weight:500">
          <span style="width:8px;height:8px;border-radius:999px;background:#AAEC58"></span>
          On-device processing only
        </div>
        <div style="display:flex;align-items:center;gap:12px;background:rgba(255,255,255,.05);border-radius:14px;padding:14px 16px;font-size:14px;font-weight:500">
          <span style="width:8px;height:8px;border-radius:999px;background:#AAEC58"></span>
          No video saved, ever
        </div>
        <div style="display:flex;align-items:center;gap:12px;background:rgba(255,255,255,.05);border-radius:14px;padding:14px 16px;font-size:14px;font-weight:500">
          <span style="width:8px;height:8px;border-radius:999px;background:#AAEC58"></span>
          No login, no cloud sync
        </div>
        <div style="display:flex;align-items:center;gap:12px;background:rgba(255,255,255,.05);border-radius:14px;padding:14px 16px;font-size:14px;font-weight:500">
          <span style="width:8px;height:8px;border-radius:999px;background:#AAEC58"></span>
          History stored locally
        </div>
      </div>
    </div>
  </div>
</section>
