---
// FAQ component
const faqs = [
  {
    q: "How do I get in touch with customer support?",
    a: "You can email our team directly at support@leanreps.com. Whether you need help setting up your phone, have encountered a bug, or want to suggest new exercise movements, we are here to help and typically respond within 24 hours."
  },
  {
    q: "Does it really count every rep?",
    a: "Yes, and it's watching your body, not a timer. If a rep doesn't reach depth it still counts, but it pulls your depth score down — that's the point."
  },
  {
    q: "What if it miscounts?",
    a: "It can, mostly when your whole body isn't in frame or the room is very dark. Reframe and it recovers. There is no manual mid-set editing — just reframe and keep going."
  },
  {
    q: "How do I set up my phone?",
    a: "Prop it about four feet away at floor level, landscape, whole body in frame. A countdown gives you time to get down and set."
  },
  {
    q: "Do I need a tripod?",
    a: "No. Lean it against a wall, a water bottle, a shoe. It just needs to sit still and see all of you."
  },
  {
    q: "Which push-ups does it support?",
    a: "Standard push-ups, front view, right now. Incline, knee, and diamond variations are next, followed by squats and other bodyweight movements."
  },
  {
    q: "Does it work in a dark room?",
    a: "It needs enough light to clearly see your body outline. Normal indoor room lighting or daylight is plenty, but pitch darkness won't work."
  },
  {
    q: "Is my video recorded or uploaded?",
    a: "No. Frames are processed on your device and discarded immediately. Nothing is saved, nothing is sent, and there's no server to send it to."
  },
  {
    q: "Do I need an account?",
    a: "No account, no email, no login. Open it and start."
  },
  {
    q: "Does it work offline?",
    a: "Yes. Everything runs on your phone, so airplane mode is fine."
  },
  {
    q: "Which phones does it work on?",
    a: "LeanReps supports devices running Android 8.0 and above, as well as iOS 18.2 and newer."
  },
  {
    q: "Will it drain my battery?",
    a: "Very little — typically around 1–2% for a standard 10–15 minute workout session."
  },
  {
    q: "Is it free?",
    a: "LeanReps is completely free during our initial rollout while we bring the system to production grade with real users. You get full access to all features with zero ads and no credit card required. Once we reach our target standards and build our core community, we plan to introduce paid options."
  },
  {
    q: "Do I need a watch or any other hardware?",
    a: "No. Just your phone."
  },
  {
    q: "What happens to my history if I get a new phone?",
    a: "Your workout history is stored strictly on your local device for privacy. We are working on a local data export and transfer feature for an upcoming update."
  },
  {
    q: "Do I need headphones for the voice cues?",
    a: "No, your phone's built-in speaker is plenty. Voice cues can be toggled on or off per exercise in Settings, and you can also adjust default values and targets for each exercise."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};
---

<section id="support" class="section-pad" style="max-width:960px;margin:0 auto;padding:112px 32px 0">
  <div id="faq" style="position:relative;top:-100px;visibility:hidden" aria-hidden="true"></div>
  
  <div style="text-align:center">
    <div style="font-size:11.5px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#AAEC58">Support & FAQ</div>
    <h2 class="section-title" style="margin:14px auto 0;font-size:40px;line-height:1.1;font-weight:700;letter-spacing:-.028em;max-width:580px">
      Support / Frequently Asked Questions
    </h2>
    <p style="margin:16px auto 0;font-size:16px;line-height:1.6;color:rgba(242,244,245,.65);max-width:540px">
      Find quick answers below, or get in touch with our team anytime if you need a hand.
    </p>
  </div>

  <!-- Direct Support Contact Card -->
  <div class="support-card" style="margin-top:40px;border-radius:24px;background:rgba(255,255,255,.035);border:1px solid rgba(170,236,88,.22);padding:28px 32px;display:flex;align-items:center;justify-content:space-between;gap:24px;position:relative;overflow:hidden">
    <div style="position:absolute;top:0;right:0;width:240px;height:100%;background:radial-gradient(circle at right center, rgba(170,236,88,0.08) 0%, transparent 70%);pointer-events:none"></div>
    <div style="max-width:520px;position:relative;z-index:1">
      <div style="display:flex;align-items:center;gap:10px">
        <span style="display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:10px;background:rgba(170,236,88,.15);color:#AAEC58;flex:none">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
          </svg>
        </span>
        <h3 style="margin:0;font-size:18.5px;font-weight:700;color:#F2F4F5;letter-spacing:-.015em">
          Need direct help or have feedback?
        </h3>
      </div>
      <p style="margin:10px 0 0;font-size:14.5px;line-height:1.55;color:rgba(242,244,245,.7)">
        Whether you are running into tracking issues, have questions about your form scores, or want to suggest new features — we’re here for you.
      </p>
    </div>
    <div class="support-action-box" style="position:relative;z-index:1;display:flex;flex-direction:column;align-items:flex-end;gap:8px;flex:none">
      <a href="mailto:support@leanreps.com?subject=LeanReps%20Support%20Request" class="support-mail-btn" style="display:inline-flex;align-items:center;gap:10px;padding:12px 22px;border-radius:14px;background:#AAEC58;color:#0B0E11;font-size:14px;font-weight:700;text-decoration:none;transition:transform .15s ease, background-color .15s ease, box-shadow .15s ease;box-shadow:0 10px 24px -8px rgba(170,236,88,.3)">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="20" height="16" x="2" y="4" rx="2"></rect>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
        </svg>
        <span>Email Support</span>
      </a>
      <span style="font-size:12px;color:#8b99b0;font-family:'Space Grotesk',sans-serif">
        support@leanreps.com &bull; Replies within 24h
      </span>
    </div>
  </div>

  <div class="faq-list" style="margin-top:32px;display:flex;flex-direction:column;gap:12px">
    {faqs.map((faq) => (
      <details class="faq-item" style="border-radius:20px;background:rgba(255,255,255,.035);border:1px solid rgba(255,255,255,.07);overflow:hidden;transition:background-color .2s ease, border-color .2s ease">
        <summary style="padding:22px 24px;display:flex;align-items:center;justify-content:space-between;gap:16px;cursor:pointer;list-style:none;font-size:16.5px;font-weight:600;color:#F2F4F5;user-select:none">
          <span>{faq.q}</span>
          <span class="faq-icon" style="flex:none;display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:999px;background:rgba(255,255,255,.06);transition:transform .2s ease, background-color .2s ease">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 9l6 6 6-6" />
            </svg>
          </span>
        </summary>
        <div style="padding:0 24px 22px;font-size:15px;line-height:1.6;color:rgba(242,244,245,.7);font-weight:400">
          {faq.a}
        </div>
      </details>
    ))}
  </div>

  <!-- FAQPage Schema for Google Search Rich Results -->
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</section>

<style>
  /* Remove default summary marker */
  details summary::-webkit-details-marker {
    display: none;
  }
  details summary::marker {
    display: none;
  }

  /* Interactive hover and open states */
  details.faq-item:hover {
    background: rgba(255, 255, 255, .05) !important;
    border-color: rgba(255, 255, 255, .11) !important;
  }

  details.faq-item[open] {
    background: rgba(255, 255, 255, .055) !important;
    border-color: rgba(170, 236, 88, .3) !important;
  }

  details.faq-item[open] .faq-icon {
    transform: rotate(180deg);
    background: rgba(170, 236, 88, .2) !important;
    color: #AAEC58;
  }

  /* Support card and button */
  .support-mail-btn:hover {
    background: #bcf772 !important;
    transform: translateY(-2px);
    box-shadow: 0 14px 28px -6px rgba(170, 236, 88, .45) !important;
  }

  @media (max-width: 768px) {
    .support-card {
      flex-direction: column !important;
      align-items: flex-start !important;
      padding: 24px 20px !important;
      gap: 20px !important;
    }
    .support-action-box {
      align-items: flex-start !important;
      width: 100% !important;
    }
    .support-mail-btn {
      width: 100% !important;
      justify-content: center !important;
    }
  }

  @media (max-width: 640px) {
    details.faq-item summary {
      padding: 18px 20px !important;
      font-size: 15px !important;
    }
    details.faq-item div {
      padding: 0 20px 18px !important;
      font-size: 14px !important;
    }
  }
</style>
