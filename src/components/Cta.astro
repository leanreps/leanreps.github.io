---
// CTA component
---
<section id="cta" class="section-pad" style="max-width:1120px;margin:0 auto;padding:112px 32px 0">
  <div class="cta-container cta-banner" style="border-radius:32px;background:#AAEC58;color:#0B0E11;padding:64px 56px;display:flex;align-items:center;justify-content:space-between;gap:40px;box-shadow:0 30px 60px -20px rgba(170,236,88,0.25)">
    <div>
      <h2 style="margin:0;font-size:44px;line-height:1.04;font-weight:700;letter-spacing:-.032em;max-width:460px">
        Put the phone down and start counting.
      </h2>
      <p style="margin:14px 0 0;font-size:16px;line-height:1.5;font-weight:500;opacity:.8;max-width:420px">
        Free to start. No account, no wearable, no setup beyond propping your phone.
      </p>
    </div>
    <div class="cta-buttons" style="display:flex;flex-direction:column;gap:12px;flex:none">
      <a href="#" style="padding:16px 32px;border-radius:14px;background:#0B0E11;color:#AAEC58;font-size:15px;font-weight:700;text-align:center;display:inline-block;cursor:pointer;transition:transform .15s ease, background-color .15s ease">
        Download for iOS
      </a>
      <a href="#" style="padding:16px 32px;border-radius:14px;border:1.5px solid rgba(11,14,17,.25);color:#0B0E11;font-size:15px;font-weight:600;text-align:center;display:inline-block;cursor:pointer;transition:background-color .15s ease, border-color .15s ease">
        Android
      </a>
    </div>
  </div>
</section>
