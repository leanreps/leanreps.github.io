---
// Footer component
const year = new Date().getFullYear();
---
<footer style="max-width:1120px;margin:0 auto;padding:56px 32px 48px;margin-top:56px;border-top:1px solid rgba(255,255,255,.07)">
  <div class="footer-inner" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:20px">
    <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap">
      <div style="display:flex;align-items:center;gap:10px">
        <svg width="22" height="22" viewBox="0 0 200 200" fill="none" aria-hidden="true">
          <path d="M52 68 L100 108 L148 60" stroke="#AAEC58" stroke-width="18" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M52 108 L100 68 L148 108" stroke="#AAEC58" stroke-width="18" stroke-linecap="round" stroke-linejoin="round" opacity="0.55"/>
          <line x1="80" y1="140" x2="120" y2="140" stroke="#AAEC58" stroke-width="12" stroke-linecap="round" opacity="0.85"/>
        </svg>
        <span style="font-size:15px;letter-spacing:-.01em;line-height:1"><span style="color:#F2F4F5;font-weight:700">Lean</span><span style="color:#F2F4F5;font-weight:400;opacity:0.75">Reps</span></span>
      </div>
      <span class="footer-copy" style="font-size:12.5px;font-weight:400;color:rgba(139,153,176,.65)">© {year} All rights reserved by LeanReps.</span>
    </div>
    <div style="display:flex;gap:26px;font-size:13px;font-weight:500;color:#8b99b0">
      <a href="/privacypolicy" style="color:#8b99b0;text-decoration:none;transition:color .15s ease">Privacy</a>
      <a href="mailto:support@leanreps.com" style="color:#8b99b0;text-decoration:none;transition:color .15s ease">Support</a>
      <a href="#" style="color:#8b99b0;text-decoration:none;transition:color .15s ease">Credits</a>
    </div>
  </div>
</footer>
