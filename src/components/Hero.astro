---
// Hero component
---
<section class="hero-section" style="max-width:1120px;margin:0 auto;padding:76px 32px 0">
  <div class="hero-grid" style="display:grid;grid-template-columns:1.05fr .95fr;gap:56px;align-items:center">
    <div>
      <h1 class="hero-heading" style="margin:0;font-size:56px;line-height:1.05;font-weight:700;letter-spacing:-.035em;text-wrap:balance">
        Focus on your set.<br />We’ll handle the rest.
      </h1>
      <p class="hero-desc" style="margin:20px 0 0;max-width:460px;font-size:16.5px;line-height:1.55;font-weight:400;color:rgba(242,244,245,.65)">
        LeanReps uses your camera to automatically count your push-ups and score your depth, elbow tuck, and tempo. No mid-set screen taps. Everything runs entirely on your device for total privacy.
      </p>
      <div class="hero-buttons" style="margin-top:32px;display:flex;align-items:center;gap:14px;flex-wrap:wrap">
        <a href="#cta" style="display:inline-block;transition:transform .15s ease, opacity .15s ease" aria-label="Download on the App Store">
          <img src="/app-store-badge.svg" alt="Download on the App Store" style="height:48px;width:auto;display:block" />
        </a>
        <a href="#cta" style="display:inline-block;transition:transform .15s ease, opacity .15s ease" aria-label="Get it on Google Play">
          <img src="/google-play-badge.svg" alt="Get it on Google Play" style="height:48px;width:auto;display:block" />
        </a>
      </div>
      <div class="hero-stats" style="margin-top:30px;display:flex;gap:38px">
        <div>
          <div style="font:700 26px 'Space Grotesk', sans-serif;letter-spacing:-.02em">3</div>
          <div style="margin-top:2px;font-size:11.5px;font-weight:500;color:#8b99b0">form cues scored</div>
        </div>
        <div>
          <div style="font:700 26px 'Space Grotesk', sans-serif;letter-spacing:-.02em">0</div>
          <div style="margin-top:2px;font-size:11.5px;font-weight:500;color:#8b99b0">taps during a set</div>
        </div>
        <div>
          <div style="font:700 26px 'Space Grotesk', sans-serif;letter-spacing:-.02em">100%</div>
          <div style="margin-top:2px;font-size:11.5px;font-weight:500;color:#8b99b0">on-device</div>
        </div>
      </div>
    </div>

    <!-- hero phone -->
    <div style="display:flex;justify-content:center;position:relative">
      <div style="position:absolute;width:340px;height:340px;border-radius:999px;background:#AAEC58;opacity:.12;filter:blur(70px);top:60px;pointer-events:none"></div>
      <div style="position:relative;width:286px;height:582px;border-radius:44px;background:#000;padding:9px;box-shadow:0 40px 80px -30px rgba(0,0,0,.85), inset 0 0 0 1.5px rgba(255,255,255,.12)">
        <div style="width:100%;height:100%;border-radius:36px;background:#0B0E11;background-image:repeating-linear-gradient(128deg,rgba(255,255,255,.035) 0 13px,transparent 13px 26px);overflow:hidden;position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center">
          <div style="position:absolute;top:0;left:0;right:0;height:34px;display:flex;align-items:center;justify-content:space-between;padding:0 22px;font-size:11px;font-weight:600;color:rgba(242,244,245,.8)">
            <span>9:41</span>
            <span style="display:flex;gap:6px"><span>5G</span><span>98</span></span>
          </div>
          <div style="position:absolute;top:12px;left:50%;transform:translateX(-50%);width:82px;height:20px;border-radius:999px;background:#000"></div>
          <div style="font:700 132px/.85 'Space Grotesk', sans-serif;letter-spacing:-.03em;color:#f2f4f5;animation:pfCount 2.6s ease-in-out infinite">12</div>
          <div style="margin-top:10px;font-size:12px;font-weight:500;letter-spacing:.12em;text-transform:uppercase;color:#8b99b0">reps</div>
          <div style="position:absolute;left:22px;right:22px;bottom:30px;height:48px;border-radius:999px;border:1.5px solid #AAEC58;color:#AAEC58;display:flex;align-items:center;justify-content:center;font-size:14.5px;font-weight:600;cursor:pointer">Stop set</div>
        </div>
      </div>
    </div>
  </div>
</section>
